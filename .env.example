# Safe to commit: values belong only in .env.local and your deployment host's secret settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Initial admin login credentials. Password changes are stored as a hash in Supabase.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Generate a private recovery token (at least 32 random bytes) and set it only on the server.
# A recovery token can be used once; rotate this value after recovery to enable future resets.
ADMIN_PASSWORD_RESET_TOKEN=
